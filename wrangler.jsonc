{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freemix-site",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script runs, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom domain: Cloudflare creates the DNS record and certificate on deploy.
  // The freemix.studio zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "freemix.studio", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  // Worker Previews for non-master branches (Workers Builds runs `wrangler preview`).
  // Static assets only, so previews need no settings beyond the top-level ones.
  "previews": {}
}
