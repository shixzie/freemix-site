---
const sources = ['Cameras & capture cards', 'Files, images, playlists', 'SRT, RTMP, NDI, browsers'];
const outputs = ['Displays & multiviews', 'Recorders & ISO', 'Streams & LAN HLS'];
const clients = [
  { name: 'Studio', note: 'native egui console' },
  { name: 'Browser', note: 'operator & tally pages' },
  { name: 'CLI & scripts', note: 'versioned API' },
  { name: 'Guests', note: 'WebRTC, planned' },
];
---
<div class="arch" data-reveal>
  <div class="clients">
    {clients.map((c) => (
      <div class="node client"><b>{c.name}</b><span>{c.note}</span></div>
    ))}
  </div>
  <div class="col col-src">
    {sources.map((s) => <div class="node io">{s}</div>)}
  </div>
  <div class="engine">
    <div class="engine-head">
      <span class="mono">freemixd</span>
      <span class="live-rev mono">rev <b data-engine-rev>1042</b></span>
    </div>
    <p>Single-writer engine authority. Clients send typed, revisioned commands and receive ordered events.</p>
    <ol class="pipe">
      <li>Clock</li><li>Graph</li><li>Compositor <small>wgpu</small></li><li>Audio <small>48 kHz</small></li><li>Encoders</li>
    </ol>
  </div>
  <div class="col col-out">
    {outputs.map((s) => <div class="node io">{s}</div>)}
  </div>
</div>

<style>
  .arch {
    --flow: var(--blue);
    display: grid;
    grid-template-columns: 1fr minmax(300px, 1.2fr) 1fr;
    grid-template-areas: '. clients .' 'src engine out';
    gap: 64px 72px;
    align-items: center;
  }
  .clients { grid-area: clients; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-inline: -60px; }
  .col-src { grid-area: src; }
  .col-out { grid-area: out; }
  .engine { grid-area: engine; }
  .col { display: grid; gap: 12px; }

  .node { position: relative; background: var(--panel); border: 1px solid var(--line-2); border-radius: 10px; padding: 12px 14px; font-size: 14px; }
  .client { display: grid; gap: 2px; text-align: center; }
  .client b { font-weight: 600; }
  .client span { color: var(--text-3); font-size: 12px; }
  .io { color: var(--text-2); }

  /* Flowing connectors. */
  .node::after { content: ''; position: absolute; pointer-events: none; }
  .client::after { left: 50%; top: 100%; width: 2px; height: 64px; margin-left: -1px;
    background: repeating-linear-gradient(to bottom, var(--flow) 0 6px, transparent 6px 14px); background-size: 2px 28px; animation: flow-y 0.9s linear infinite reverse; opacity: 0.7; }
  .client:nth-child(odd)::after { animation-direction: normal; }
  .col-src .io::after { left: 100%; top: 50%; height: 2px; width: 72px;
    background: repeating-linear-gradient(to right, var(--pvw) 0 6px, transparent 6px 14px); background-size: 28px 2px; animation: flow-x 0.9s linear infinite; }
  .col-out .io::after { right: 100%; top: 50%; height: 2px; width: 72px;
    background: repeating-linear-gradient(to right, var(--pgm) 0 6px, transparent 6px 14px); background-size: 28px 2px; animation: flow-x 0.9s linear infinite; }
  @keyframes flow-x { to { background-position: 28px 0 } }
  @keyframes flow-y { to { background-position: 0 28px } }

  .engine {
    position: relative; z-index: 1;
    padding: 22px; border-radius: 16px;
    background: radial-gradient(120% 120% at 50% 0%, rgba(59, 123, 255, 0.18), transparent 60%), var(--panel-2);
    border: 1px solid rgba(122, 165, 255, 0.35);
    box-shadow: 0 0 0 6px rgba(59, 123, 255, 0.05), 0 30px 80px -30px rgba(59, 123, 255, 0.5);
  }
  .engine::before { content: ''; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from var(--a, 0deg), transparent 0 75%, var(--blue-2) 88%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
    animation: orbit 5s linear infinite; }
  @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes orbit { to { --a: 360deg } }
  .engine-head { display: flex; justify-content: space-between; align-items: center; font-size: 18px; font-weight: 600; }
  .live-rev { font-size: 12px; color: var(--text-3); font-weight: 500; }
  .live-rev b { color: var(--blue-2); }
  .engine p { color: var(--text-2); font-size: 14px; margin: 10px 0 16px; }
  .pipe { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; counter-reset: s; }
  .pipe li { position: relative; font: 600 12px/1 var(--font-mono); padding: 8px 9px; border-radius: 6px; background: #0a0c10; border: 1px solid var(--line-2); color: var(--text-2);
    animation: pulse 3s var(--ease-in-out) infinite; animation-delay: calc(var(--k) * 0.3s); }
  .pipe li:nth-child(1) { --k: 0 } .pipe li:nth-child(2) { --k: 1 } .pipe li:nth-child(3) { --k: 2 } .pipe li:nth-child(4) { --k: 3 } .pipe li:nth-child(5) { --k: 4 }
  .pipe small { color: var(--text-3); font-weight: 500; }
  @keyframes pulse { 0%, 20%, 100% { border-color: var(--line-2); color: var(--text-2); box-shadow: none } 8% { border-color: var(--blue-2); color: #fff; box-shadow: 0 0 16px -4px var(--blue) } }

  @media (max-width: 960px) {
    .arch { grid-template-columns: 1fr; grid-template-areas: 'src' 'engine' 'out' 'clients'; gap: 40px; }
    .clients { margin: 0; grid-template-columns: repeat(2, 1fr); }
    .col { grid-template-columns: repeat(3, 1fr); }
    .col-src .io::after, .col-out .io::after { left: 50%; right: auto; top: 100%; width: 2px; height: 40px; margin-left: -1px; background-size: 2px 28px; animation-name: flow-y; }
    .col-src .io::after { background-image: repeating-linear-gradient(to bottom, var(--pvw) 0 6px, transparent 6px 14px); }
    .col-out .io::after { top: auto; bottom: 100%; background-image: repeating-linear-gradient(to bottom, var(--pgm) 0 6px, transparent 6px 14px); }
    .client::after { top: auto; bottom: 100%; height: 40px; }
    .clients .client:nth-child(n + 3)::after { display: none; }
  }
  @media (max-width: 560px) {
    .col { grid-template-columns: 1fr; }
    .io { text-align: center; }
    .col-src .io:not(:last-child)::after, .col-out .io:not(:first-child)::after { display: none; }
    .col-src .io:last-child::after { height: 40px; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-engine-rev]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let n = 1042;
    setInterval(() => (el.textContent = String((n += 1 + Math.floor(Math.random() * 3)))), 900);
  }
</script>
