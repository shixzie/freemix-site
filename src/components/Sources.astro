---
// Procedural "camera feeds" for the switcher demo. Every size is in container
// query units so the same source renders as a thumbnail or a monitor.
---
<template data-source="bars" data-name="Colour Bars">
  <div class="feed bars">
    <div class="b-top">{['#c0c0c0', '#c0c000', '#00c0c0', '#00c000', '#c000c0', '#c00000', '#0000c0'].map((c) => <i style={`background:${c}`}></i>)}</div>
    <div class="b-mid">{['#0000c0', '#131313', '#c000c0', '#131313', '#00c0c0', '#131313', '#c0c0c0'].map((c) => <i style={`background:${c}`}></i>)}</div>
    <div class="b-low"><i style="background:#00214c"></i><i style="background:#fff"></i><i style="background:#32006a"></i><i style="background:#131313;flex:3"></i></div>
    <span class="b-id">FREEMIX · 1080p59.94</span>
  </div>
</template>

<template data-source="stage" data-name="Camera 1 Wide">
  <div class="feed stage">
    <div class="beam b1"></div><div class="beam b2"></div><div class="beam b3"></div><div class="beam b4"></div>
    <div class="haze"></div>
    <div class="truss"></div>
    <div class="crowd"></div>
  </div>
</template>

<template data-source="scene" data-name="Main Scene">
  <div class="feed scene">
    <div class="box left"><div class="person p1"></div></div>
    <div class="box right"><div class="person p2"></div></div>
    <div class="l3">
      <div class="l3-bar"></div>
      <div class="l3-text"><b>Maya Chen</b><span>Remote guest · Lisbon</span></div>
    </div>
  </div>
</template>

<template data-source="sports" data-name="Match Graphics">
  <div class="feed sports">
    <div class="pitch"></div>
    <div class="bug">
      <span class="team">HOM</span><span class="score">2</span><span class="score">1</span><span class="team">AWY</span>
      <span class="clock" data-clock>72:14</span>
    </div>
    <div class="ticker"><div class="crawl">
      <span>FREEMIX SPORTS</span><span>Replay up to eight cameras</span><span>Live scoreboards from any data source</span><span>Highlights while you record</span>
      <span>FREEMIX SPORTS</span><span>Replay up to eight cameras</span><span>Live scoreboards from any data source</span><span>Highlights while you record</span>
    </div></div>
  </div>
</template>

<style is:global>
  .feed { position: absolute; inset: 0; overflow: hidden; container-type: size; }

  /* Bars */
  .bars { display: flex; flex-direction: column; background: #131313; }
  .bars > div { display: flex; }
  .bars i { flex: 1; display: block; }
  .b-top { flex: 67; }
  .b-mid { flex: 8; }
  .b-low { flex: 25; }
  .b-id { position: absolute; left: 50%; top: 32%; transform: translateX(-50%); font: 600 3.2cqw/1 var(--font-mono); color: #fff; background: rgba(0,0,0,0.65); padding: 1.2cqw 2cqw; letter-spacing: 0.1em; white-space: nowrap; }

  /* Stage */
  .stage { background: radial-gradient(120% 90% at 50% 0%, #1d1650 0%, #0b0a1d 55%, #050409 100%); }
  .stage .beam { position: absolute; top: -10%; width: 22cqw; height: 130%; transform-origin: 50% 0; mix-blend-mode: screen; filter: blur(1.4cqw);
    background: linear-gradient(to bottom, var(--c) 0%, transparent 80%); clip-path: polygon(45% 0, 55% 0, 100% 100%, 0 100%); opacity: 0.75; animation: sweep var(--d) ease-in-out infinite alternate; }
  .stage .b1 { left: 4%; --c: #6d5bff; --d: 3.8s; }
  .stage .b2 { left: 28%; --c: #ff3fa4; --d: 4.6s; animation-delay: -1.2s; }
  .stage .b3 { left: 52%; --c: #3bd6ff; --d: 3.4s; animation-delay: -2s; }
  .stage .b4 { left: 76%; --c: #ffb03b; --d: 5.2s; animation-delay: -0.6s; }
  @keyframes sweep { from { transform: rotate(-24deg); } to { transform: rotate(24deg); } }
  .stage .haze { position: absolute; inset: 0; background: radial-gradient(60% 40% at 50% 85%, rgba(140, 110, 255, 0.35), transparent 70%); animation: breathe 3s ease-in-out infinite alternate; }
  @keyframes breathe { from { opacity: 0.6 } to { opacity: 1 } }
  .stage .truss { position: absolute; left: 0; right: 0; top: 6%; height: 2.2cqw; background: repeating-linear-gradient(90deg, #2a2840 0 2cqw, #15141f 2cqw 4cqw); box-shadow: 0 0.6cqw 2cqw #000; }
  .stage .crowd { position: absolute; left: -5%; right: -5%; bottom: -2%; height: 26%;
    background:
      radial-gradient(circle at 50% 30%, #000 0 34%, transparent 36%) 0 0 / 7cqw 12cqh,
      radial-gradient(ellipse at 50% 100%, #000 0 60%, transparent 62%) 0 6cqh / 7cqw 22cqh,
      radial-gradient(circle at 50% 30%, #07060c 0 34%, transparent 36%) 3.5cqw 4cqh / 7cqw 12cqh,
      radial-gradient(ellipse at 50% 100%, #07060c 0 60%, transparent 62%) 3.5cqw 10cqh / 7cqw 22cqh;
    animation: bob 0.9s ease-in-out infinite alternate; }
  @keyframes bob { from { transform: translateY(0) } to { transform: translateY(1.2cqh) } }

  /* Two-box scene */
  .scene { background: linear-gradient(120deg, #0e1f4a, #2b0f45 50%, #0b3a4a); background-size: 200% 200%; animation: pan 8s ease-in-out infinite alternate; }
  @keyframes pan { from { background-position: 0% 50% } to { background-position: 100% 50% } }
  .scene .box { position: absolute; top: 12%; width: 44%; aspect-ratio: 16 / 10; border-radius: 1.4cqw; overflow: hidden; box-shadow: 0 2cqw 5cqw rgba(0,0,0,0.5), inset 0 0 0 0.3cqw rgba(255,255,255,0.15); }
  .scene .left { left: 4%; background: linear-gradient(160deg, #3b5d8f, #1b2a45); }
  .scene .right { right: 4%; background: linear-gradient(200deg, #8f5a3b, #452a1b); }
  .scene .person { position: absolute; left: 50%; bottom: -10%; width: 46%; aspect-ratio: 1 / 1.25; transform: translateX(-50%);
    background: radial-gradient(circle at 50% 28%, var(--skin) 0 20%, transparent 21%), radial-gradient(ellipse at 50% 100%, var(--shirt) 0 58%, transparent 59%);
    animation: talk 2.4s ease-in-out infinite alternate; }
  .scene .p1 { --skin: #e7b996; --shirt: #e7ecf5; }
  .scene .p2 { --skin: #b98260; --shirt: #20242c; animation-delay: -1.1s; }
  @keyframes talk { 0% { transform: translateX(-50%) rotate(-2deg) } 100% { transform: translateX(-48%) rotate(2deg) } }
  .scene .l3 { position: absolute; left: 6%; bottom: 10%; display: flex; align-items: stretch; animation: l3in 6s var(--ease-out) infinite; }
  .scene .l3-bar { width: 1.2cqw; background: var(--blue); }
  .scene .l3-text { background: rgba(10, 14, 24, 0.88); padding: 1.4cqw 2.6cqw 1.6cqw 2cqw; display: grid; gap: 0.6cqw; }
  .scene .l3-text b { font: 700 4.4cqw/1 var(--font-display); color: #fff; letter-spacing: -0.01em; }
  .scene .l3-text span { font: 500 2.4cqw/1 var(--font-sans); color: #b8c4dc; }
  @keyframes l3in { 0% { clip-path: inset(0 100% 0 0) } 12%, 88% { clip-path: inset(0 0 0 0) } 100% { clip-path: inset(0 100% 0 0) } }

  /* Sports */
  .sports { background: #0b3a1c; }
  .sports .pitch { position: absolute; inset: -10% -30%; background: repeating-linear-gradient(90deg, #1b7a3a 0 9cqw, #176c33 9cqw 18cqw); transform: perspective(60cqw) rotateX(52deg); transform-origin: 50% 0;
    animation: drift 12s linear infinite; }
  .sports .pitch::after { content: ''; position: absolute; left: 50%; top: 20%; width: 34cqw; height: 34cqw; margin-left: -17cqw; border: 0.5cqw solid rgba(255,255,255,0.75); border-radius: 50%; }
  .sports .pitch::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 0.5cqw; background: rgba(255,255,255,0.75); }
  @keyframes drift { from { transform: perspective(60cqw) rotateX(52deg) translateX(-6cqw) } 50% { transform: perspective(60cqw) rotateX(52deg) translateX(6cqw) } to { transform: perspective(60cqw) rotateX(52deg) translateX(-6cqw) } }
  .sports .bug { position: absolute; left: 4%; top: 6%; display: flex; align-items: stretch; font: 700 3.4cqw/1 var(--font-display); color: #fff; box-shadow: 0 1cqw 3cqw rgba(0,0,0,0.45); }
  .sports .bug > span { padding: 1.2cqw 1.6cqw; display: flex; align-items: center; }
  .sports .team { background: #0c1220; letter-spacing: 0.08em; }
  .sports .score { background: #fff; color: #0c1220; min-width: 5cqw; justify-content: center; }
  .sports .clock { background: var(--pgm); font-family: var(--font-mono); font-weight: 600; }
  .sports .ticker { position: absolute; left: 0; right: 0; bottom: 0; height: 8.5cqw; background: rgba(8, 12, 22, 0.92); border-top: 0.5cqw solid var(--amber); overflow: hidden; display: flex; align-items: center; }
  .sports .crawl { display: flex; white-space: nowrap; animation: crawl 14s linear infinite; }
  .sports .crawl span { font: 600 3cqw/1 var(--font-sans); color: #e8edf6; padding-inline: 3cqw; position: relative; }
  .sports .crawl span::after { content: '◆'; position: absolute; right: -1cqw; color: var(--amber); font-size: 2cqw; top: 0.4cqw; }
  @keyframes crawl { to { transform: translateX(-50%) } }
</style>
