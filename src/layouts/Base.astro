---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { REPO, url } from '../data/site';

interface Props { title: string; description: string; current?: 'home' | 'features' | 'roadmap' }
const { title, description, current = 'home' } = Astro.props;
const links = [
  { href: url('features/'), label: 'Features', key: 'features' },
  { href: url('roadmap/'), label: 'Roadmap', key: 'roadmap' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07080b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-nav">
      <nav class="wrap nav-inner" aria-label="Main">
        <a href={url()} class="home" aria-label="FreeMix home"><Logo /></a>
        <div class="links">
          {links.map((l) => (
            <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
          ))}
          <a class="gh" href={REPO} rel="noopener">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
            <span>GitHub</span>
          </a>
        </div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo size={18} />
          <p>An open, GPU-first live production system written in Rust. Dual licensed MIT or Apache-2.0.</p>
        </div>
        <div class="foot-links">
          <a href={url('features/')}>Features</a>
          <a href={url('roadmap/')}>Roadmap</a>
          <a href={`${REPO}/tree/master/docs/spec`} rel="noopener">Specification</a>
          <a href={REPO} rel="noopener">Source</a>
        </div>
        <p class="fine">FreeMix is an independent project targeting vMix-class functionality. It is not affiliated with or endorsed by vMix or StudioCoast.</p>
      </div>
    </footer>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--blue); color: #fff; padding: 10px 14px; border-radius: 8px; }
  .skip:focus { left: 8px; }
  .site-nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    transition: background 0.35s, border-color 0.35s, backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  :global(.site-nav.scrolled) { background: rgba(7, 8, 11, 0.72); backdrop-filter: blur(14px) saturate(1.4); border-color: var(--line); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 12px; }
  .home { text-decoration: none; }
  .links { display: flex; align-items: center; gap: clamp(4px, 2vw, 28px); }
  .links a { text-decoration: none; color: var(--text-2); font-weight: 500; font-size: 15px; padding: 8px 6px; position: relative; transition: color 0.2s; }
  .links a:hover, .links a[aria-current='page'] { color: var(--text); }
  .links a::after { content: ''; position: absolute; left: 6px; right: 6px; bottom: 2px; height: 2px; border-radius: 2px; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform 0.45s var(--ease-out); }
  .links a:hover::after, .links a[aria-current='page']::after { transform: scaleX(1); }
  .gh { display: inline-flex; align-items: center; gap: 8px; }
  .gh svg { width: 18px; height: 18px; }
  @media (max-width: 420px) { .gh span { display: none; } }

  .site-footer { border-top: 1px solid var(--line); padding-block: 56px 40px; background: var(--bg-2); }
  .foot { display: grid; gap: 28px; grid-template-columns: 1fr auto; }
  .foot-brand p { color: var(--text-3); max-width: 46ch; margin: 14px 0 0; font-size: 14px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 22px; align-content: start; }
  .foot-links a { color: var(--text-2); text-decoration: none; font-size: 14px; }
  .foot-links a:hover { color: var(--text); }
  .fine { grid-column: 1 / -1; color: var(--text-3); font-size: 12px; margin: 0; border-top: 1px solid var(--line); padding-top: 22px; }
  @media (max-width: 720px) { .foot { grid-template-columns: 1fr; } }
</style>
