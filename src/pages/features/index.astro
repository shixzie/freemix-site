---
import Base from '../../layouts/Base.astro';
import { features, AREAS, PHASES, totals, generatedFrom } from '../../data/roadmap';
import { REPO, url } from '../../data/site';

const areas = Object.entries(AREAS);
const phaseName = (n: number) => PHASES.find((p) => p.n === n)?.short ?? '';
const evidence = (f: (typeof features)[number]) => (f.status === 'blocked' ? 'sdk' : f.testsPresent ? 'tested' : 'planned');
const EVIDENCE = { tested: 'Tests present', planned: 'Planned', sdk: 'Needs licensed SDK' } as const;
const PRIORITY = { P0: 'Foundation', P1: 'Professional', P2: 'Full parity' } as Record<string, string>;
const scenarios = [
  ['Basic show', 'Four cameras, two clips, a title and a browser source in a two-box scene, cut, transitioned, streamed and recorded for an hour.'],
  ['Failure recovery', 'Pull an on-air camera, the encoder network, a display and a control client. Fallbacks hold and every part recovers.'],
  ['Remote show', 'Eight guests join with mix-minus and return video while a remote producer runs the show from a browser.'],
  ['Sports show', 'Eight cameras record continuously while the replay operator marks, angles, slows and plays a highlight.'],
  ['Portable project', 'Bundle a project, open it on another OS, and reproduce layout, routing, data, shortcuts and media.'],
  ['Automation', 'A controller previews, fires a stinger, updates a title, starts recording, reconnects and resumes with no duplicate actions.'],
];
---
<Base title="Planned features · FreeMix" description="Every capability on the FreeMix parity ledger, with priority, roadmap phase and test evidence." current="features">
  <section class="ft-hero">
    <div class="wrap">
      <span class="eyebrow" data-reveal style="--eyebrow-dot: var(--violet)">Planned features</span>
      <h1 class="split">Every feature, tracked.</h1>
      <p class="lede" data-reveal style="--i: 3">
        The parity ledger lists {totals.rows} capabilities across inputs, switching, graphics, audio, outputs and control. Each row has a priority, a roadmap phase and an acceptance test before it can be called done.
      </p>
    </div>
  </section>

  <section class="wrap catalog" data-catalog>
    <div class="filters" role="search">
      <div class="chips" role="group" aria-label="Area">
        <button type="button" class="fchip on" data-area="all">All</button>
        {areas.map(([, a]) => <button type="button" class="fchip" data-area={a.key} style={`--c:${a.color}`}><i></i>{a.label}</button>)}
      </div>
      <div class="row2">
        <div class="chips" role="group" aria-label="Priority">
          {Object.entries(PRIORITY).map(([p, l]) => <button type="button" class="fchip pri on" data-pri={p} aria-pressed="true"><b>{p}</b>{l}</button>)}
        </div>
        <label class="search"><span class="sr">Search features</span>
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="m14 14 4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input type="search" placeholder="Search, e.g. SRT, replay, keying" data-q />
        </label>
      </div>
      <p class="count mono" aria-live="polite"><span data-count-shown>{features.length}</span> of {features.length} rows</p>
    </div>

    <ul class="cards" data-cards>
      {features.map((f) => {
        const a = AREAS[f.area];
        const e = evidence(f);
        return (
          <li class="card" id={f.id} data-area={a.key} data-pri={f.priority} data-text={`${f.id} ${f.capability} ${f.acceptance}`.toLowerCase()} style={`--c:${a.color}`}>
            <div class="card-top">
              <span class="id mono">{f.id}</span>
              <span class="pri-tag mono" title={PRIORITY[f.priority]}>{f.priority}</span>
            </div>
            <h3>{f.capability}</h3>
            <p class="acc">{f.acceptance}</p>
            <div class="card-foot">
              <a class="phase mono" href={url(`roadmap/#phase-${f.phase}`)}>Phase {f.phase} · {phaseName(f.phase)}</a>
              <span class={`ev ${e}`}>{EVIDENCE[e]}</span>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="empty" data-empty hidden>No rows match. Try a broader search.</p>
  </section>

  <section class="section scen">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow" data-reveal style="--eyebrow-dot: var(--pgm)">Acceptance scenarios</span>
        <h2 class="split">Six shows decide when it's done.</h2>
        <p class="lede" data-reveal>Beyond single rows, FreeMix reaches parity only when these end-to-end productions pass on every applicable platform, along with a 24-hour run with no drift, leaks or lost control.</p>
      </div>
      <ol class="scen-list" data-stagger>
        {scenarios.map(([t, d], i) => (
          <li data-reveal><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
      <p class="src mono">Ledger snapshot from <a href={`${REPO}/blob/${generatedFrom.commit}/docs/spec/feature-parity.md`} rel="noopener">freemix@{generatedFrom.commit}</a>. "Tests present" means acceptance test files exist for the row, not that the row is complete.</p>
    </div>
  </section>
</Base>

<style>
  .ft-hero { padding-top: clamp(120px, 16vw, 180px); padding-bottom: 40px; position: relative; overflow: hidden; }
  .ft-hero::before { content: ''; position: absolute; width: 700px; height: 700px; left: -240px; top: -260px; border-radius: 50%; background: radial-gradient(circle, rgba(155, 107, 255, 0.22), transparent 65%); filter: blur(30px); }
  .ft-hero .wrap { display: grid; gap: 24px; position: relative; }
  .ft-hero h1 { font-size: clamp(44px, 8vw, 96px); font-weight: 600; letter-spacing: -0.035em; line-height: 0.98; }

  .filters { position: sticky; top: 64px; z-index: 10; display: grid; gap: 12px; padding: 16px 0; margin-bottom: 20px; background: linear-gradient(to bottom, var(--bg) 80%, transparent); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .row2 { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; }
  .fchip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; border: 1px solid var(--line-2); background: var(--panel); color: var(--text-2); font: 500 13px/1 var(--font-sans); cursor: pointer; transition: all 0.25s var(--ease-out); }
  .fchip i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .fchip b { font: 700 11px/1 var(--font-mono); color: var(--text-3); }
  .fchip:hover { color: var(--text); border-color: var(--text-3); }
  .fchip.on { color: var(--text); border-color: var(--c, var(--blue)); background: color-mix(in srgb, var(--c, var(--blue)) 16%, var(--panel)); }
  .fchip.pri:not(.on) { opacity: 0.5; text-decoration: line-through; }
  .search { display: flex; align-items: center; gap: 8px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--panel); color: var(--text-3); min-width: min(320px, 100%); flex: 1; max-width: 380px; }
  .search:focus-within { border-color: var(--blue); }
  .search svg { width: 16px; height: 16px; flex: none; }
  .search input { flex: 1; min-width: 0; background: none; border: 0; color: var(--text); font: 15px var(--font-sans); padding: 10px 0; outline: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .count { font-size: 12px; color: var(--text-3); margin: 0; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 14px; }
  .card { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 20px; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); scroll-margin-top: 220px;
    transition: border-color 0.3s, transform 0.4s var(--ease-out); overflow: hidden; }
  .card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); opacity: 0.8; }
  .card:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .card:target { border-color: var(--c); box-shadow: 0 0 0 1px var(--c), 0 0 40px -10px var(--c); animation: target 1.2s var(--ease-out); }
  @keyframes target { from { transform: scale(1.03) } }
  .card[hidden] { display: none; }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .id { font-size: 12px; color: var(--text-3); font-weight: 600; }
  .pri-tag { font-size: 11px; font-weight: 700; padding: 4px 6px; border-radius: 4px; border: 1px solid var(--line-2); color: var(--text-2); }
  [data-pri='P0'] .pri-tag { color: #fff; border-color: transparent; background: var(--pgm); }
  .card h3 { font-size: 17px; }
  .acc { margin: 0; font-size: 14px; color: var(--text-3); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card:hover .acc, .card:target .acc { -webkit-line-clamp: unset; color: var(--text-2); }
  .card-foot { margin-top: auto; padding-top: 6px; display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .phase { font-size: 11.5px; color: var(--text-3); text-decoration: none; }
  .phase:hover { color: var(--blue-2); }
  .ev { font: 600 10.5px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; padding: 5px 7px; border-radius: 5px; }
  .ev.tested { color: var(--blue-2); background: rgba(59, 123, 255, 0.12); }
  .ev.planned { color: var(--text-3); background: var(--panel-2); }
  .ev.sdk { color: var(--amber); background: rgba(245, 165, 36, 0.1); }
  .empty { color: var(--text-3); text-align: center; padding: 60px 0; }

  .scen-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .scen-list li { background: var(--bg); padding: 28px; display: grid; gap: 10px; align-content: start; transition: background 0.3s; }
  .scen-list li:hover { background: var(--panel); }
  .scen-list span { font-size: 12px; color: var(--pgm); font-weight: 600; }
  .scen-list p { margin: 0; color: var(--text-2); font-size: 15px; }
  .src { color: var(--text-3); font-size: 12px; margin-top: 28px; }
  .src a { color: var(--text-2); }
  @media (max-width: 900px) { .scen-list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .scen-list { grid-template-columns: 1fr; } .filters { position: static; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-catalog]')!;
  const cards = Array.from(root.querySelectorAll<HTMLElement>('.card'));
  const areaBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-area]')).filter((b) => b.tagName === 'BUTTON');
  const priBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-pri]'));
  const q = root.querySelector<HTMLInputElement>('[data-q]')!;
  const shown = root.querySelector<HTMLElement>('[data-count-shown]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let area = 'all';

  const apply = () => {
    const pris = new Set(priBtns.filter((b) => b.classList.contains('on')).map((b) => b.dataset.pri));
    const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let n = 0;
    const appearing: HTMLElement[] = [];
    for (const c of cards) {
      const ok = (area === 'all' || c.dataset.area === area) && pris.has(c.dataset.pri) && terms.every((t) => c.dataset.text!.includes(t));
      if (ok && c.hidden) appearing.push(c);
      c.hidden = !ok;
      if (ok) n++;
    }
    shown.textContent = String(n);
    empty.hidden = n > 0;
    if (!reduced) appearing.slice(0, 24).forEach((c, i) =>
      c.animate([{ opacity: 0, transform: 'translateY(16px) scale(.98)' }, { opacity: 1, transform: 'none' }], { duration: 500, delay: i * 25, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'backwards' }));
  };

  areaBtns.forEach((b) => b.addEventListener('click', () => {
    area = b.dataset.area!;
    areaBtns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    apply();
  }));
  priBtns.forEach((b) => b.addEventListener('click', () => {
    b.classList.toggle('on');
    b.setAttribute('aria-pressed', String(b.classList.contains('on')));
    apply();
  }));
  q.addEventListener('input', apply);
</script>
