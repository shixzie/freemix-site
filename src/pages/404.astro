---
import Base from '../layouts/Base.astro';
import { url } from '../data/site';
---
<Base title="Signal lost · FreeMix" description="This page is not on the program bus.">
  <section class="lost">
    <div class="bars" aria-hidden="true">{['#c0c0c0', '#c0c000', '#00c0c0', '#00c000', '#c000c0', '#c00000', '#0000c0'].map((c) => <i style={`background:${c}`}></i>)}</div>
    <div class="wrap copy">
      <span class="eyebrow" style="--eyebrow-dot: var(--pgm)">404 · No signal</span>
      <h1 class="split">This input is offline.</h1>
      <p class="lede">The page you asked for isn't routed to Program. The fallback is the home page.</p>
      <a class="btn primary" href={url()}>Back to Program</a>
    </div>
  </section>
</Base>

<style>
  .lost { position: relative; min-height: 100vh; display: grid; place-items: center; overflow: hidden; padding-block: 120px 80px; }
  .bars { position: absolute; inset: 0; display: flex; opacity: 0.08; filter: blur(2px); animation: roll 6s linear infinite; }
  .bars i { flex: 1; }
  @keyframes roll { 0%, 92%, 100% { transform: none } 94% { transform: translateX(-2%) skewX(4deg) } 96% { transform: translateX(1%) } }
  .copy { position: relative; display: grid; gap: 22px; justify-items: center; text-align: center; }
  h1 { font-size: clamp(40px, 7vw, 88px); font-weight: 600; letter-spacing: -0.035em; }
  .lede { margin: 0; }
</style>
